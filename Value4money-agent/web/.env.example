# Local development only. The dev proxy (web/vite.config.ts) needs the API token, because
# EventSource cannot set headers and the token must never reach the browser. Copy this to web/.env
# and set the same value as API_TOKEN in the package's own .env.
#
# This file is a template: it holds no secret.
API_TOKEN=paste-the-same-value-as-API_TOKEN-in-the-python-env-here

# Deployment (Vercel project settings, NOT this file). These are server-side variables read by the
# proxy function in web/api/[...path].ts. Leave them unprefixed so Vite never inlines them into the
# public bundle. The value of API_TOKEN must match the one set on the Render backend:
#
#   BACKEND_URL=https://your-backend.onrender.com
#   API_TOKEN=<the same secret as the Render backend>
#
# Never use a VITE_ prefix for either one: VITE_* variables are compiled into the client JavaScript
# and would hand the token to every visitor.
