# Copy this file to .env and fill in the three values marked REQUIRED. Never commit .env.

# REQUIRED. A Postgres database you control. Neon and Supabase free tiers work; a local
# Postgres or a Docker container work too. The agent needs Postgres specifically.
DATABASE_URL=

# REQUIRED. No model default: pick one and say which provider serves it.
# LLM_PROVIDER=groq or ollama. For ollama use e.g. "llama3.1:70b".
LLM_PROVIDER=groq
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=120

# Groq only. Put your real key here, never in this file.
GROQ_API_KEY=

# Ollama only, used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Where the bid PDFs live, and where reports are written. Both default to the folders in the
# repository, so most people never touch these.
BIDS_DIR=sample_bids
OUTPUTS_DIR=outputs

# Research thresholds. max_scale_ratio drops a candidate award whose value is more than this many
# times, above or below, the median bid total: a 20,000 award is not a cheap 4,000,000 job.
MIN_COMPARABLES=5
GOOD_POOL_N=10
FAR_FROM_MEDIAN_PCT=50
MAX_SCALE_RATIO=10.0
MAX_RESEARCH_ATTEMPTS=3
MAX_DRAFT_ATTEMPTS=2
# Audit writes reuse this many connections. Keep it small: a free Postgres may only allow a few.
AUDIT_POOL_SIZE=4

# The borrowed Postgres MCP server, used only as a research fallback when the first searches come
# back too thin. Leave COMMUNITY_MCP_DATABASE_URL empty to turn it off.
COMMUNITY_MCP_ENABLED=true
COMMUNITY_MCP_COMMAND=uvx
COMMUNITY_MCP_ARGS=--with mcp<2 postgres-mcp
COMMUNITY_MCP_ACCESS_MODE=restricted
COMMUNITY_MCP_DATABASE_URL=
COMMUNITY_MCP_MAX_ROWS=30

# Tracing. With OPIK_ENABLED=false or no key, tracing is off and nothing else changes.
# Turn it off to run without sending tender content to Opik.
OPIK_ENABLED=true
OPIK_PROJECT_NAME=value4money-agent
OPIK_WORKSPACE=
# Put your real key here, never in this file.
OPIK_API_KEY=